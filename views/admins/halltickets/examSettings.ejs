

<div class="min-h-screen p-4 md:p-8">

    <!-- PAGE HEADER -->

    <div class="mb-8">

        <p class="text-sm text-gray-400 mb-2">
            Examination / Settings
        </p>

        <h1 class="text-2xl md:text-3xl font-bold text-white">
            Examination Cell Settings
        </h1>

        <p class="text-gray-400 mt-2 text-sm">
            Manage examination contact details displayed on student Hall Tickets.
        </p>

    </div>


    <!-- MAIN GRID -->

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">


        <!-- SETTINGS FORM -->

        <div class="xl:col-span-8">

            <div class="
                bg-gray-900/70
                border
                border-white/10
                rounded-2xl
                p-6
                md:p-8
            ">


                <div class="mb-7">

                    <h2 class="text-xl font-bold text-white">
                        Examination Desk Configuration
                    </h2>

                    <p class="text-sm text-gray-400 mt-1">
                        Updated information will automatically appear on published Hall Tickets.
                    </p>

                </div>


                <form
                    action="/admin/exam-settings"
                    method="POST"
                    class="space-y-6"
                >


                    <!-- CONTROLLER OFFICER -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">
                            Controller Officer
                        </label>


                        <input
                            type="text"
                            name="controllerOfficer"
                            value="<%= settings.controllerOfficer || '' %>"
                            placeholder="Dr. Raghavan Pillai"
                            required
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                placeholder-gray-600
                                outline-none
                                focus:border-purple-500
                                transition
                            "
                        >

                    </div>


                    <!-- HELPLINE + EMAIL -->

                    <div class="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5
                    ">


                        <!-- HELPLINE -->

                        <div>

                            <label class="
                                block
                                text-sm
                                font-medium
                                text-gray-300
                                mb-2
                            ">
                                Official Helpline
                            </label>


                            <input
                                type="text"
                                name="officialHelpline"
                                value="<%= settings.officialHelpline || '' %>"
                                placeholder="+91 98765 43210"
                                required
                                class="
                                    w-full
                                    bg-white/5
                                    border
                                    border-white/10
                                    rounded-xl
                                    px-4
                                    py-3
                                    text-white
                                    placeholder-gray-600
                                    outline-none
                                    focus:border-purple-500
                                    transition
                                "
                            >

                        </div>


                        <!-- EMAIL -->

                        <div>

                            <label class="
                                block
                                text-sm
                                font-medium
                                text-gray-300
                                mb-2
                            ">
                                Desk Email
                            </label>


                            <input
                                type="email"
                                name="deskEmail"
                                value="<%= settings.deskEmail || '' %>"
                                placeholder="examcell@avi.edu.in"
                                required
                                class="
                                    w-full
                                    bg-white/5
                                    border
                                    border-white/10
                                    rounded-xl
                                    px-4
                                    py-3
                                    text-white
                                    placeholder-gray-600
                                    outline-none
                                    focus:border-purple-500
                                    transition
                                "
                            >

                        </div>


                    </div>


                    <!-- OFFICE HOURS -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">
                            In-Office Hours
                        </label>


                        <input
                            type="text"
                            name="officeHours"
                            value="<%= settings.officeHours || '' %>"
                            placeholder="09:00 AM - 05:00 PM"
                            required
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                placeholder-gray-600
                                outline-none
                                focus:border-purple-500
                                transition
                            "
                        >

                    </div>


                    <!-- GOOGLE MAP -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">
                            Exam Hall Google Map Link
                        </label>


                        <input
                            type="url"
                            name="googleMap"
                            value="<%= settings.googleMap || '' %>"
                            placeholder="https://maps.google.com/..."
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                placeholder-gray-600
                                outline-none
                                focus:border-purple-500
                                transition
                            "
                        >


                        <p class="
                            text-xs
                            text-gray-500
                            mt-2
                        ">
                            Add the official examination center Google Maps link.
                        </p>

                    </div>


                    <!-- SAVE BUTTON -->

                    <div class="
                        flex
                        justify-end
                        pt-3
                    ">

                        <button
                            type="submit"
                            class="
                                px-6
                                py-3
                                rounded-xl
                                bg-gradient-to-r
                                from-purple-600
                                to-indigo-600
                                text-white
                                text-sm
                                font-semibold
                                hover:scale-[1.02]
                                transition
                            "
                        >
                            Save Exam Settings
                        </button>

                    </div>


                </form>

            </div>

        </div>


        <!-- LIVE PREVIEW -->

        <div class="xl:col-span-4">

            <div class="
                bg-gray-900/70
                border
                border-white/10
                rounded-2xl
                p-6
                sticky
                top-6
            ">


                <p class="
                    text-[10px]
                    uppercase
                    tracking-widest
                    text-gray-500
                    mb-4
                ">
                    Student Hall Ticket Preview
                </p>


                <div class="
                    bg-white/5
                    border
                    border-white/10
                    rounded-2xl
                    p-5
                ">


                    <h3 class="
                        text-white
                        font-bold
                        mb-5
                    ">
                        Examination Cell Desk
                    </h3>


                    <div class="space-y-4 text-xs">


                        <div class="
                            flex
                            justify-between
                            gap-4
                            border-b
                            border-white/5
                            pb-3
                        ">

                            <span class="text-gray-500">
                                Controller Officer
                            </span>

                            <span class="
                                text-white
                                font-medium
                                text-right
                            ">
                                <%= settings.controllerOfficer || "Not Available" %>
                            </span>

                        </div>


                        <div class="
                            flex
                            justify-between
                            gap-4
                            border-b
                            border-white/5
                            pb-3
                        ">

                            <span class="text-gray-500">
                                Official Helpline
                            </span>

                            <span class="
                                text-white
                                font-medium
                                text-right
                            ">
                                <%= settings.officialHelpline || "Not Available" %>
                            </span>

                        </div>


                        <div class="
                            flex
                            justify-between
                            gap-4
                            border-b
                            border-white/5
                            pb-3
                        ">

                            <span class="text-gray-500">
                                Desk Email
                            </span>

                            <span class="
                                text-white
                                font-medium
                                text-right
                                break-all
                            ">
                                <%= settings.deskEmail || "Not Available" %>
                            </span>

                        </div>


                        <div class="
                            flex
                            justify-between
                            gap-4
                        ">

                            <span class="text-gray-500">
                                In-Office Hours
                            </span>

                            <span class="
                                text-white
                                font-medium
                                text-right
                            ">
                                <%= settings.officeHours || "Not Available" %>
                            </span>

                        </div>


                    </div>


                </div>


                <div class="
                    mt-5
                    bg-blue-500/5
                    border
                    border-blue-500/20
                    rounded-xl
                    p-4
                ">

                    <p class="
                        text-blue-400
                        text-xs
                        font-semibold
                    ">
                        Automatic Student Update
                    </p>

                    <p class="
                        text-gray-400
                        text-xs
                        mt-1
                        leading-relaxed
                    ">
                        Saving these settings updates the Examination Cell details
                        for all student Hall Tickets.
                    </p>

                </div>


            </div>

        </div>


    </div>

</div>