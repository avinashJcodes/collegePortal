<!-- =========================================
     EDIT HALL TICKET
========================================== -->

<div class="min-h-screen p-4 md:p-8">

    <!-- PAGE HEADER -->
    <div class="mb-8">

        <p class="text-sm text-gray-400 mb-2">
            Examination / Hall Tickets / Edit
        </p>

        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">

            <div>

                <h1 class="text-2xl md:text-3xl font-bold text-white">
                    Edit Hall Ticket
                </h1>

                <p class="text-gray-400 mt-2 text-sm">
                    Update examination details and student permissions.
                </p>

            </div>


            <!-- HALL TICKET STATUS -->

            <% if (hallTicket.published) { %>

                <span class="
                    inline-flex
                    items-center
                    gap-2
                    px-4
                    py-2
                    rounded-xl
                    bg-green-500/10
                    border
                    border-green-500/20
                    text-green-400
                    text-xs
                    font-semibold
                    w-fit
                ">

                    <span class="w-2 h-2 rounded-full bg-green-400"></span>

                    Published

                </span>

            <% } else { %>

                <span class="
                    inline-flex
                    items-center
                    gap-2
                    px-4
                    py-2
                    rounded-xl
                    bg-orange-500/10
                    border
                    border-orange-500/20
                    text-orange-400
                    text-xs
                    font-semibold
                    w-fit
                ">

                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>

                    Unpublished

                </span>

            <% } %>

        </div>

    </div>



    <!-- MAIN GRID -->

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">


        <!-- =========================================
             STUDENT INFORMATION
        ========================================== -->

        <div class="xl:col-span-4">

            <div class="
                bg-gray-900/70
                border
                border-white/10
                rounded-2xl
                p-6
            ">

                <h2 class="text-lg font-bold text-white mb-6">
                    Student Information
                </h2>


                <!-- STUDENT PROFILE -->

                <div class="flex items-center gap-4 mb-6">

                    <img
                        src="<%= student.profileImage || '/images/student.png' %>"
                        alt="Student"
                        class="
                            w-16
                            h-16
                            rounded-xl
                            object-cover
                            border
                            border-white/10
                        "
                    >


                    <div class="min-w-0">

                        <h3 class="
                            text-white
                            font-bold
                            text-lg
                            truncate
                        ">

                            <%= student.fullname || student.fullName || "Student" %>

                        </h3>


                        <p class="
                            text-gray-400
                            text-sm
                            truncate
                        ">

                            <%= student.email || "--" %>

                        </p>

                    </div>

                </div>



                <!-- STUDENT DETAILS -->

                <div class="space-y-4 text-sm">


                    <div class="
                        flex
                        justify-between
                        gap-4
                        border-b
                        border-white/5
                        pb-3
                    ">

                        <span class="text-gray-500">
                            Admission Number
                        </span>

                        <span class="
                            text-white
                            font-medium
                            text-right
                        ">

                            <%= student.admissionNumber || "--" %>

                        </span>

                    </div>



                    <div class="
                        flex
                        justify-between
                        gap-4
                        border-b
                        border-white/5
                        pb-3
                    ">

                        <span class="text-gray-500">
                            Roll Number
                        </span>

                        <span class="
                            text-white
                            font-medium
                            text-right
                        ">

                            <%= student.rollNumber || "Not Assigned" %>

                        </span>

                    </div>



                    <div class="
                        flex
                        justify-between
                        gap-4
                        border-b
                        border-white/5
                        pb-3
                    ">

                        <span class="text-gray-500">
                            Course
                        </span>

                        <span class="
                            text-white
                            font-medium
                            text-right
                        ">

                            <%= student.course || "Not Assigned" %>

                        </span>

                    </div>



                    <div class="
                        flex
                        justify-between
                        gap-4
                        border-b
                        border-white/5
                        pb-3
                    ">

                        <span class="text-gray-500">
                            Branch
                        </span>

                        <span class="
                            text-white
                            font-medium
                            text-right
                        ">

                            <%= student.branch || "Not Assigned" %>

                        </span>

                    </div>



                    <div class="
                        flex
                        justify-between
                        gap-4
                    ">

                        <span class="text-gray-500">
                            Semester
                        </span>

                        <span class="
                            text-white
                            font-medium
                            text-right
                        ">

                            Semester <%= student.semester || "--" %>

                        </span>

                    </div>

                </div>


                <!-- HALL TICKET META -->

                <div class="
                    mt-6
                    pt-6
                    border-t
                    border-white/10
                ">

                    <p class="
                        text-[10px]
                        uppercase
                        tracking-wider
                        text-gray-500
                        mb-3
                    ">

                        Current Hall Ticket

                    </p>


                    <div class="
                        bg-white/5
                        border
                        border-white/10
                        rounded-xl
                        p-4
                    ">

                        <p class="
                            text-xs
                            text-gray-500
                            mb-1
                        ">

                            Hall Ticket Number

                        </p>


                        <p class="
                            text-white
                            font-mono
                            font-bold
                        ">

                            <%= hallTicket.hallTicketNumber || "--" %>

                        </p>

                    </div>

                </div>

            </div>

        </div>



        <!-- =========================================
             EDIT FORM
        ========================================== -->

        <div class="xl:col-span-8">

            <div class="
                bg-gray-900/70
                border
                border-white/10
                rounded-2xl
                p-6
                md:p-8
            ">


                <div class="mb-7">

                    <h2 class="text-xl font-bold text-white">
                        Hall Ticket Configuration
                    </h2>

                    <p class="text-sm text-gray-400 mt-1">
                        Changes will be reflected on the student's Hall Ticket page.
                    </p>

                </div>



                <form
                    action="/admin/halltickets/edit/<%= hallTicket._id %>"
                    method="POST"
                    class="space-y-6"
                >


                    <!-- HALL TICKET + SEAT NUMBER -->

                    <div class="
                        grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5
                    ">


                        <!-- HALL TICKET NUMBER -->

                        <div>

                            <label class="
                                block
                                text-sm
                                font-medium
                                text-gray-300
                                mb-2
                            ">

                                Hall Ticket Number

                            </label>


                            <input
                                type="text"
                                name="hallTicketNumber"
                                value="<%= hallTicket.hallTicketNumber || '' %>"
                                required
                                class="
                                    w-full
                                    bg-white/5
                                    border
                                    border-white/10
                                    rounded-xl
                                    px-4
                                    py-3
                                    text-white
                                    outline-none
                                    focus:border-purple-500
                                    transition
                                "
                            >

                        </div>



                        <!-- SEAT NUMBER -->

                        <div>

                            <label class="
                                block
                                text-sm
                                font-medium
                                text-gray-300
                                mb-2
                            ">

                                Seat Number

                            </label>


                            <input
                                type="text"
                                name="seatNumber"
                                value="<%= hallTicket.seatNumber || '' %>"
                                required
                                class="
                                    w-full
                                    bg-white/5
                                    border
                                    border-white/10
                                    rounded-xl
                                    px-4
                                    py-3
                                    text-white
                                    outline-none
                                    focus:border-purple-500
                                    transition
                                "
                            >

                        </div>


                    </div>



                    <!-- EXAM TYPE -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">

                            Examination Type

                        </label>


                        <input
                            type="text"
                            name="examType"
                            value="<%= hallTicket.examType || '' %>"
                            required
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                outline-none
                                focus:border-purple-500
                                transition
                            "
                        >

                    </div>


                    <div>

    <label class="block text-sm font-medium text-gray-300 mb-2">
        Academic Year
    </label>

    <input
        type="text"
        name="academicYear"
        value="<%= hallTicket.academicYear || '' %>"
        required
        placeholder="2025-26"
        pattern="[0-9]{4}-[0-9]{2}"
        title="Enter academic year like 2025-26"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white outline-none focus:border-purple-500 transition"
    >

</div>


                    <!-- EXAM CENTER -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">

                            Examination Center

                        </label>


                        <input
                            type="text"
                            name="examCenter"
                            value="<%= hallTicket.examCenter || '' %>"
                            required
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                outline-none
                                focus:border-purple-500
                                transition
                            "
                        >

                    </div>



                    <!-- EXAM CENTER ADDRESS -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">

                            Examination Center Address

                        </label>


                        <textarea
                            name="examCenterAddress"
                            rows="3"
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                outline-none
                                focus:border-purple-500
                                transition
                                resize-none
                            "
                        ><%= hallTicket.examCenterAddress || '' %></textarea>

                    </div>



                    <!-- REPORTING TIME -->

                    <div>

                        <label class="
                            block
                            text-sm
                            font-medium
                            text-gray-300
                            mb-2
                        ">

                            Reporting Time

                        </label>


                        <input
                            type="time"
                            name="reportingTime"
                            value="<%= hallTicket.reportingTime || '' %>"
                            required
                            class="
                                w-full
                                bg-white/5
                                border
                                border-white/10
                                rounded-xl
                                px-4
                                py-3
                                text-white
                                outline-none
                                focus:border-purple-500
                                transition
                            "
                        >

                    </div>



                    <!-- =========================================
                         STUDENT PERMISSIONS
                    ========================================== -->

                    <div class="
                        border
                        border-white/10
                        rounded-2xl
                        p-5
                    ">


                        <h3 class="
                            text-white
                            font-semibold
                            mb-5
                        ">

                            Student Permissions

                        </h3>



                        <div class="space-y-4">


                            <!-- DOWNLOAD -->

                            <label class="
                                flex
                                items-center
                                justify-between
                                gap-5
                                cursor-pointer
                            ">


                                <div>

                                    <p class="
                                        text-white
                                        text-sm
                                        font-medium
                                    ">

                                        Allow PDF Download

                                    </p>


                                    <p class="
                                        text-gray-500
                                        text-xs
                                        mt-1
                                    ">

                                        Student can save the Hall Ticket as PDF.

                                    </p>

                                </div>


                                <input
                                    type="checkbox"
                                    name="allowDownload"
                                    <%= hallTicket.allowDownload ? "checked" : "" %>
                                    class="
                                        w-5
                                        h-5
                                        accent-purple-600
                                    "
                                >

                            </label>



                            <div class="border-t border-white/5"></div>



                            <!-- PRINT -->

                            <label class="
                                flex
                                items-center
                                justify-between
                                gap-5
                                cursor-pointer
                            ">


                                <div>

                                    <p class="
                                        text-white
                                        text-sm
                                        font-medium
                                    ">

                                        Allow Print

                                    </p>


                                    <p class="
                                        text-gray-500
                                        text-xs
                                        mt-1
                                    ">

                                        Student can print the official Hall Ticket.

                                    </p>

                                </div>


                                <input
                                    type="checkbox"
                                    name="allowPrint"
                                    <%= hallTicket.allowPrint ? "checked" : "" %>
                                    class="
                                        w-5
                                        h-5
                                        accent-purple-600
                                    "
                                >

                            </label>



                            <div class="border-t border-white/5"></div>



                            <!-- PUBLISH -->

                            <label class="
                                flex
                                items-center
                                justify-between
                                gap-5
                                cursor-pointer
                            ">


                                <div>

                                    <p class="
                                        text-white
                                        text-sm
                                        font-medium
                                    ">

                                        Publish Hall Ticket

                                    </p>


                                    <p class="
                                        text-gray-500
                                        text-xs
                                        mt-1
                                    ">

                                        Student can view this Hall Ticket after publishing.

                                    </p>

                                </div>


                                <input
                                    type="checkbox"
                                    name="published"
                                    <%= hallTicket.published ? "checked" : "" %>
                                    class="
                                        w-5
                                        h-5
                                        accent-purple-600
                                    "
                                >

                            </label>


                        </div>


                    </div>



                    <!-- WARNING -->

                    <% if (hallTicket.published) { %>

                        <div class="
                            bg-yellow-500/5
                            border
                            border-yellow-500/20
                            rounded-xl
                            p-4
                        ">

                            <div class="flex items-start gap-3">

                                <div class="
                                    w-8
                                    h-8
                                    rounded-lg
                                    bg-yellow-500/10
                                    flex
                                    items-center
                                    justify-center
                                    flex-shrink-0
                                ">

                                    <span class="text-yellow-400">
                                        !
                                    </span>

                                </div>


                                <div>

                                    <p class="
                                        text-yellow-400
                                        text-sm
                                        font-semibold
                                    ">

                                        Published Hall Ticket

                                    </p>


                                    <p class="
                                        text-gray-400
                                        text-xs
                                        mt-1
                                        leading-relaxed
                                    ">

                                        This Hall Ticket is currently visible to the student.
                                        Saved changes will automatically appear on the student's page.

                                    </p>

                                </div>

                            </div>

                        </div>

                    <% } %>



                    <!-- =========================================
                         FORM BUTTONS
                    ========================================== -->

                    <div class="
                        flex
                        flex-col
                        sm:flex-row
                        justify-end
                        gap-3
                        pt-3
                    ">


                        <a
                            href="/admin/halltickets"
                            class="
                                px-6
                                py-3
                                rounded-xl
                                border
                                border-white/10
                                text-gray-300
                                text-sm
                                font-semibold
                                text-center
                                hover:bg-white/5
                                transition
                            "
                        >

                            Cancel

                        </a>



                        <button
                            type="submit"
                            class="
                                px-6
                                py-3
                                rounded-xl
                                bg-gradient-to-r
                                from-purple-600
                                to-indigo-600
                                text-white
                                text-sm
                                font-semibold
                                hover:scale-[1.02]
                                transition
                            "
                        >

                            Update Hall Ticket

                        </button>


                    </div>


                </form>


            </div>

        </div>


    </div>

</div>