

<!-- ================= 3. DASHBOARD MAIN CONTENT (MAHADBT 2.0 WHITE UI) ================= -->
<div class="bg-[#f4f6f9] min-h-[calc(100vh-120px)] py-6 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">

        <!-- WELCOME STRIP / APPLICANT STATUS PANEL -->
        <div class="bg-white border border-slate-200 rounded-xl p-5 sm:p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6 border-l-4 border-l-[#f47721]">
            <div>
                <div class="inline-flex items-center gap-1.5 text-[11px] font-extrabold text-[#f47721] uppercase tracking-wider mb-1">
                    <i class="fa-solid fa-id-card-clip"></i> Applicant / Student Dashboard
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-[#082444]">
                    Welcome, 
                    <span class="text-[#f47721]">
                        <%= (typeof student !== 'undefined' && student && student.fullname) ? student.fullname : 'Student' %>
                    </span>
                </h1>
                <p class="text-slate-600 text-xs sm:text-sm mt-1 max-w-2xl leading-relaxed">
                    Access your verified academic profile, examination fee receipts, hall tickets, biometric attendance, and circulars.
                </p>
            </div>

            <div class="bg-[#f8fafc] border border-slate-200 rounded-lg px-4 py-3 flex-shrink-0 self-start md:self-auto shadow-inner">
                <p class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">
                    Application Status
                </p>
                <div class="flex items-center gap-2 mt-1">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-slate-900 text-xs font-bold uppercase tracking-wide">
                        Verified & Active
                    </span>
                </div>
            </div>
        </div>

        <!-- ================= 4. DASHBOARD CARDS GRID ================= -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            <!-- CARD 1: PROFILE INFORMATION (MahaDBT Standard Details Card) -->
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between overflow-hidden">
                <!-- Card Header -->
                <div class="bg-[#f8fafc] px-5 py-3.5 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded bg-[#082444] text-white flex items-center justify-center text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <h2 class="text-sm font-extrabold text-[#082444] uppercase tracking-wide">
                            Student Profile Details
                        </h2>
                    </div>
                    <span class="text-[10px] font-extrabold text-[#f47721] bg-orange-50 border border-orange-200 px-2 py-0.5 rounded">
                        ERP ID
                    </span>
                </div>

                <!-- Card Body -->
                <div class="p-5 space-y-3 text-xs flex-1">
                    <div class="flex justify-between items-center py-1.5 border-b border-slate-100">
                        <span class="text-slate-500 font-medium">Candidate Name:</span>
                        <span class="text-[#082444] font-bold text-right">
                            <%= (typeof student !== 'undefined' && student && student.fullname) ? student.fullname : "Not Available" %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center py-1.5 border-b border-slate-100">
                        <span class="text-slate-500 font-medium">Roll / PRN Number:</span>
                        <span class="text-[#f47721] font-extrabold">
                            <%= (typeof student !== 'undefined' && student && student.rollNumber) ? student.rollNumber : "---" %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center py-1.5 border-b border-slate-100">
                        <span class="text-slate-500 font-medium">Branch / Department:</span>
                        <span class="text-slate-800 font-bold">
                            <%= (typeof student !== 'undefined' && student && student.department) ? student.department : "Computer Engineering" %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center pt-1">
                        <span class="text-slate-500 font-medium">Scrutiny Status:</span>
                        <% if(typeof student !== 'undefined' && student && student.isProfileComplete){ %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[11px]">
                                <i class="fa-solid fa-circle-check text-[10px]"></i> Completed & Verified
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-red-100 text-red-800 font-bold text-[11px]">
                                <i class="fa-solid fa-circle-exclamation text-[10px]"></i> Incomplete Profile
                            </span>
                        <% } %>
                    </div>
                </div>

                <!-- Card Footer Action -->
                <div class="bg-[#f8fafc] px-5 py-2.5 border-t border-slate-200">
                    <a href="/student/profile" class="text-xs font-bold text-[#f47721] hover:text-[#d95f0b] flex items-center justify-between">
                        <span>Edit / View Full Profile</span>
                        <i class="fa-solid fa-angle-right text-[11px]"></i>
                    </a>
                </div>
            </div>

            <!-- CARD 2: NOTICE BOARD (MahaDBT Official Circulars Card) -->
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between overflow-hidden">
                <!-- Card Header -->
                <div class="bg-[#f8fafc] px-5 py-3.5 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded bg-blue-700 text-white flex items-center justify-center text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>
                        <h2 class="text-sm font-extrabold text-[#082444] uppercase tracking-wide">
                            Notices & Circulars
                        </h2>
                    </div>
                    <span class="text-[10px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded">
                        Latest
                    </span>
                </div>

                <!-- Card Body -->
                <div class="p-5 flex-1 flex flex-col justify-center">
                    <% if(typeof hasNewNotice !== 'undefined' && hasNewNotice){ %>
                        <div class="rounded-lg border border-red-200 bg-red-50/70 p-3.5">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-red-600 animate-ping"></span>
                                <span class="font-bold text-red-800 text-xs">
                                    New Notice Available
                                </span>
                            </div>
                            <p class="text-xs text-red-700 mt-1.5 leading-relaxed">
                                University Examination schedule & CAP verification circular published. Please check immediately.
                            </p>
                        </div>
                    <% } else { %>
                        <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 text-center">
                            <i class="fa-regular fa-bell-slash text-slate-400 text-lg mb-1 block"></i>
                            <p class="text-slate-500 text-xs font-medium">
                                There are no unread official circulars today.
                            </p>
                        </div>
                    <% } %>
                </div>

                <!-- Card Footer Action -->
                <div class="bg-[#f8fafc] px-5 py-2.5 border-t border-slate-200">
                    <a href="/student/notices" class="text-xs font-bold text-[#082444] hover:text-[#f47721] flex items-center justify-between">
                        <span>Open Notice Board</span>
                        <i class="fa-solid fa-angle-right text-[11px]"></i>
                    </a>
                </div>
            </div>

            <!-- CARD 3: BIOMETRIC ATTENDANCE (MahaDBT Attendance Card) -->
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between overflow-hidden">
                <!-- Card Header -->
                <div class="bg-[#f8fafc] px-5 py-3.5 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded bg-emerald-700 text-white flex items-center justify-center text-xs font-bold shadow-sm">
                            <i class="fa-solid fa-clipboard-user"></i>
                        </div>
                        <h2 class="text-sm font-extrabold text-[#082444] uppercase tracking-wide">
                            Biometric Attendance
                        </h2>
                    </div>
                    <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded">
                        Semester
                    </span>
                </div>

                <!-- Card Body -->
                <div class="p-5 flex-1">
                    <!-- Progress Bar -->
                    <div class="mb-4">
                        <div class="flex items-baseline justify-between mb-1">
                            <h3 class="text-3xl font-extrabold text-emerald-700">
                                75%
                            </h3>
                            <span class="text-[11px] font-bold text-slate-500 uppercase">
                                Overall Status
                            </span>
                        </div>
                        <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden border border-slate-200">
                            <div class="h-full w-[75%] bg-emerald-600 rounded-full"></div>
                        </div>
                    </div>

                    <!-- Counters -->
                    <div class="grid grid-cols-2 gap-2.5 mb-3">
                        <div class="bg-slate-50 rounded-lg p-2 border border-slate-200 text-center">
                            <span class="text-slate-500 text-[10px] font-bold uppercase">Present Days</span>
                            <div class="text-base font-extrabold text-emerald-800">72</div>
                        </div>
                        <div class="bg-slate-50 rounded-lg p-2 border border-slate-200 text-center">
                            <span class="text-slate-500 text-[10px] font-bold uppercase">Absent Days</span>
                            <div class="text-base font-extrabold text-rose-700">24</div>
                        </div>
                    </div>

                    <div class="p-2 rounded bg-emerald-50 border border-emerald-200 text-center">
                        <p class="text-emerald-800 font-bold text-[11px]">
                            <i class="fa-solid fa-circle-check me-1"></i> Eligible for University Exam
                        </p>
                    </div>
                </div>

                <!-- Card Footer Action -->
                <div class="bg-[#f8fafc] px-5 py-2.5 border-t border-slate-200">
                    <div class="text-[11px] text-slate-500 flex items-center justify-between">
                        <span>Threshold Limit: ≥ 75.0%</span>
                        <span class="text-emerald-700 font-bold">Compliant</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- ================= 5. PROFILE INCOMPLETE MODAL (MahaDBT 2.0 WHITE MODAL) ================= -->
<% if (typeof student !== 'undefined' && student && !student.isProfileComplete) { %>
<div class="fixed inset-0 z-[1000] flex items-center justify-center p-4 overflow-hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
    
    <div class="relative bg-white border border-slate-300 rounded-xl p-6 sm:p-8 w-full max-w-md shadow-2xl animate-in zoom-in duration-300">
        <div class="flex items-center gap-3.5 mb-4">
            <div class="w-12 h-12 rounded-lg bg-orange-100 border border-orange-200 text-[#f47721] flex items-center justify-center text-xl flex-shrink-0 font-bold">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <h2 class="text-lg font-extrabold text-[#082444] leading-tight">Student Identity Incomplete</h2>
                <p class="text-[10px] font-bold text-[#f47721] uppercase tracking-wider mt-0.5">MahaDBT Scrutiny Guardrail</p>
            </div>
        </div>

        <div class="h-px bg-slate-200 mb-4"></div>

        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-6">
            To generate examination hall tickets, view semester grade cards, and access scholarship modules, you must finalize your profile verification.
        </p>

        <a href="/student/profile"
           class="block w-full text-center bg-[#f47721] hover:bg-[#d95f0b] text-white font-extrabold py-3 rounded-lg shadow-md transition-all uppercase tracking-wider text-xs">
            <i class="fa-solid fa-id-card me-1"></i> Complete Profile Verification
        </a>
    </div>
</div>
<% } %>

<!-- ================= 6. WARNING ALERT MODAL (MahaDBT 2.0 WHITE MODAL) ================= -->
<% if (typeof student !== 'undefined' && student && student.showWarning) { %>
<div class="fixed inset-0 z-[2000] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
    <div class="relative bg-white border-2 border-red-500 text-slate-800 p-6 sm:p-8 rounded-xl text-center max-w-lg shadow-2xl">
        <div class="w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl font-bold">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h2 class="text-xl font-extrabold text-[#082444] mb-2 uppercase tracking-wide">Official Institutional Alert</h2>
        <p class="mb-6 text-slate-600 text-xs sm:text-sm font-medium leading-relaxed bg-red-50 border border-red-200 p-3 rounded-lg">
            <%= student.warningMessage %>
        </p>

        <form action="/student/clear-warning" method="POST">
            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg font-bold text-xs uppercase tracking-widest transition-all shadow-md">
                I Acknowledge & Understand
            </button>
        </form>
    </div>
</div>
<% } %>

<!-- Loader Script Timer -->
<script>
    setTimeout(() => {
        const loader = document.getElementById('loader');
        if(loader) loader.classList.add('opacity-0', 'pointer-events-none');
    }, 600);
</script>