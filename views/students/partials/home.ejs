<!-- Tailwind CSS (CDN, configured) -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Poppins', 'sans-serif'],
        },
        colors: {
          primary: {
            DEFAULT: '#7C3AED',
            50: '#F5F3FF',
            100: '#EDE4FF',
            200: '#DCC9FF',
            300: '#C4A3FE',
            400: '#A575FA',
            500: '#7C3AED',
            600: '#6D28D9',
            700: '#5B21B6',
            800: '#4C1D95',
            900: '#341264',
          },
          sky: '#EC4899',
          violet: '#D946EF',
          ink: '#180A2E',
        },
        boxShadow: {
          soft: '0 10px 40px -10px rgba(124, 58, 237, 0.35)',
          glass: '0 8px 32px 0 rgba(107, 33, 168, 0.18)',
          glow: '0 0 25px rgba(217, 70, 239, 0.45), 0 0 60px rgba(124, 58, 237, 0.25)',
        },
        animation: {
          'float': 'float 6s ease-in-out infinite',
          'float-slow': 'float 9s ease-in-out infinite',
          'marquee': 'marquee 30s linear infinite',
          'gradient-x': 'gradient-x 6s ease infinite',
          'blob': 'blob 12s infinite',
        },
        keyframes: {
          float: {
            '0%, 100%': { transform: 'translateY(0px)' },
            '50%': { transform: 'translateY(-18px)' },
          },
          marquee: {
            '0%': { transform: 'translateX(0)' },
            '100%': { transform: 'translateX(-50%)' },
          },
          'gradient-x': {
            '0%, 100%': { 'background-position': '0% 50%' },
            '50%': { 'background-position': '100% 50%' },
          },
          blob: {
            '0%, 100%': { transform: 'translate(0px, 0px) scale(1)' },
            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
            '66%': { transform: 'translate(-20px, 20px) scale(0.95)' },
          },
        },
      },
    },
  }
</script>

<!-- AOS Animate on Scroll -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.1/aos.css" rel="stylesheet">

<style>
  html { scroll-behavior: smooth; }
  body { font-family: 'Poppins', sans-serif; background:#FBF8FF; color:#180A2E; }

  /* Glassmorphism navbar */
  .glass-nav {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Gradient text */
  .grad-text {
    background: linear-gradient(90deg, #7C3AED, #D946EF, #EC4899);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-x 6s ease infinite;
  }

  /* Circuit pattern background for hero (engineering motif) */
  .circuit-bg {
    background-image:
      linear-gradient(rgba(24,10,46,0.82), rgba(46,16,84,0.78)),
      url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1740&q=80');
    background-size: cover;
    background-position: center;
  }

  .dot-grid {
    background-image: radial-gradient(rgba(255,255,255,0.18) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 9px; }
  ::-webkit-scrollbar-track { background: #F1E9FF; }
  ::-webkit-scrollbar-thumb { background: linear-gradient(#7C3AED, #D946EF); border-radius: 10px; }

  /* Marquee for placement partner logos */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }
  .marquee-track:hover { animation-play-state: paused; }

  /* Card hover lift */
  .lift { transition: transform .35s ease, box-shadow .35s ease; }
  .lift:hover { transform: translateY(-10px); box-shadow: 0 20px 45px -15px rgba(124,58,237,.45); }

  /* Gallery overlay */
  .gallery-item img { transition: transform .6s ease; }
  .gallery-item:hover img { transform: scale(1.12); }
  .gallery-overlay {
    background: linear-gradient(to top, rgba(24,10,46,0.92), rgba(24,10,46,0.1) 60%);
    opacity: 0;
    transition: opacity .4s ease;
  }
  .gallery-item:hover .gallery-overlay { opacity: 1; }

  /* Section eyebrow */
  .eyebrow {
    letter-spacing: .18em;
  }

  /* Nav underline animation */
  .nav-link { position: relative; }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -4px;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg,#7C3AED,#EC4899);
    transition: width .3s ease;
  }
  .nav-link:hover::after { width: 100%; }
  .nav-link:hover { color: #7C3AED; }

  /* Stylish glow for premium buttons */
  .btn-glow { position: relative; overflow: hidden; }
  .btn-glow::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    transform: translateX(-120%);
    transition: transform .7s ease;
  }
  .btn-glow:hover::before { transform: translateX(120%); }

  /* Blob decoration */
  .blob { filter: blur(60px); }

  /* Testimonial fade */
  .testimonial-slide { display:none; }
  .testimonial-slide.active { display:block; animation: fadein .6s ease; }
  @keyframes fadein { from{opacity:0; transform: translateY(12px);} to{opacity:1; transform:translateY(0);} }

  /* Loader for counters */
  .counter { font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>
</head>

