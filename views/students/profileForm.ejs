<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile & Credentials | MahaDBT 2.0 Student ERP</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --mahadbt-navy: #0b2546;
            --mahadbt-navy-dark: #071930;
            --mahadbt-orange: #f47721;
            --mahadbt-orange-dark: #d95f0b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .heading-font {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Clean MahaDBT Form Input Styling */
        .mahadbt-input {
            width: 100%;
            background-color: #f8fafc;
            border: 1.5px solid #e2e8f0;
            color: #1e293b;
            padding: 0.75rem 1rem;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .mahadbt-input:focus {
            background-color: #ffffff;
            border-color: #f47721;
            outline: none;
            box-shadow: 0 0 0 3px rgba(244, 119, 33, 0.15);
        }

        .mahadbt-input-readonly {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
            color: #64748b !important;
            cursor: not-allowed;
            user-select: none;
        }

        .mahadbt-label {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #475569;
            margin-bottom: 0.5rem;
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800 antialiased flex flex-col">



  

    <!-- ================= 3. MAIN FORM CONTAINER ================= -->
    <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-6 md:p-8 space-y-6">

        <!-- Breadcrumbs Navigation -->
        <nav class="flex items-center gap-2 text-xs text-slate-500 no-print">
            <a href="/student/dashboard" class="hover:text-[#f47721]">Home</a>
            <span>/</span>
            <a href="/student/profile" class="hover:text-[#f47721]">Student Profile</a>
            <span>/</span>
            <span class="text-slate-700 font-semibold">Edit Credentials</span>
        </nav>

        <!-- Page Header Banner -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-7 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 right-0 w-80 h-full bg-gradient-to-l from-orange-50 via-orange-50/40 to-transparent pointer-events-none"></div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 relative z-10">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-[#0b2546] text-[#f47721] flex items-center justify-center font-bold flex-shrink-0 shadow-sm">
                        <i data-lucide="user-cog" class="w-6 h-6 text-[#f47721]"></i>
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-[#0b2546] tracking-tight heading-font">
                            Update Student Profile & DBT Record
                        </h1>
                        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                            Keep your communication, academic affiliation, and bank-seeded identity details current.
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 self-start md:self-auto">
                    <div class="bg-emerald-50 border border-emerald-200/80 px-3.5 py-2 rounded-xl flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/15 text-emerald-700 flex items-center justify-center font-bold">
                            <i data-lucide="shield-check" class="w-4 h-4"></i>
                        </div>
                        <div class="text-left">
                            <span class="text-[10px] uppercase font-extrabold text-emerald-800 tracking-wider block">Identity Record</span>
                            <span class="text-xs font-bold text-emerald-900">ERP Verified Ledger</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= MAIN EDIT FORM ================= -->
        <form action="/student/profile" method="POST" enctype="multipart/form-data" class="space-y-6">

            <!-- ================= 1. PROFILE PHOTO SECTION ================= -->
            <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm">
                
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#f47721]"></span>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            1. Profile Photograph
                        </h2>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">Passport Format (JPG / PNG)</span>
                </div>

                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
                    
                    <!-- Avatar Preview Container with Upload Camera Overlay -->
                    <div class="relative w-32 h-32 rounded-2xl overflow-hidden border-2 border-[#f47721] p-1 bg-white shadow-md flex-shrink-0 group">
                        <img id="profilePreview"
                             src="<%= student.profileImage || 'https://ui-avatars.com/api/?background=0b2546&color=ffffff&size=200&name=' + encodeURIComponent(student.fullname) %>"
                             alt="Student Avatar"
                             class="w-full h-full object-cover rounded-xl transition duration-200 group-hover:opacity-90">

                        <label for="profileImage"
                               class="absolute bottom-2 right-2 bg-[#0b2546] hover:bg-[#f47721] text-white p-2 rounded-xl cursor-pointer border-2 border-white shadow-md transition-all active:scale-95"
                               title="Click to Upload New Photograph">
                            <i data-lucide="camera" class="w-4 h-4"></i>
                        </label>

                        <input type="file" 
                               id="profileImage" 
                               name="profileImage"
                               class="hidden" 
                               accept="image/*" 
                               onchange="previewImage(event)">
                    </div>

                    <!-- Upload Guidelines -->
                    <div class="space-y-2 text-center sm:text-left">
                        <h3 class="text-base font-bold text-[#0b2546]">
                            Candidate Identity Photo
                        </h3>
                        <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-xl">
                            Please upload a clear front-facing passport size photo with a light background. This photo will be printed on your university hall tickets, marks transcripts, and digital campus gate passes.
                        </p>
                        
                        <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-2 text-xs">
                            <label for="profileImage" 
                                   class="cursor-pointer inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-orange-50 border border-orange-200 text-[#d95f0b] font-bold hover:bg-orange-100 transition shadow-xs">
                                <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                                <span>Choose File</span>
                            </label>
                            <span class="text-slate-400 text-xs">(Max size: 2MB)</span>
                        </div>
                    </div>

                </div>

            </section>

            <!-- ================= 2. PERSONAL INFORMATION ================= -->
            <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm">
                
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#f47721]"></span>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            2. Personal Information
                        </h2>
                    </div>
                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-md flex items-center gap-1">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> UIDAI Verified
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    
                    <!-- Full Name (Readonly) -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="user" class="w-3.5 h-3.5 text-orange-500"></i>
                            Candidate Full Name
                        </label>
                        <input readonly 
                               value="<%= student.fullname %>"
                               class="mahadbt-input mahadbt-input-readonly font-semibold text-[#0b2546]"
                               placeholder="Full name as per records"
                               title="Contact administration office to request a legal name alteration">
                    </div>

                    <!-- Email Address (Readonly) -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="mail" class="w-3.5 h-3.5 text-orange-500"></i>
                            Registered Official Email
                        </label>
                        <input readonly 
                               value="<%= student.email %>"
                               class="mahadbt-input mahadbt-input-readonly font-medium"
                               placeholder="Official email address">
                    </div>

                    <!-- Mobile Number -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="phone" class="w-3.5 h-3.5 text-orange-500"></i>
                            Mobile Number <span class="text-red-500">*</span>
                        </label>
                        <input name="phone" 
                               value="<%= student.phone || '' %>"
                               maxlength="10"
                               placeholder="Enter 10 digit mobile number"
                               class="mahadbt-input font-mono" 
                               required>
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="calendar" class="w-3.5 h-3.5 text-orange-500"></i>
                            Date of Birth <span class="text-red-500">*</span>
                        </label>
                        <input type="date" 
                               name="dob"
                               value="<%= student.dob ? (typeof student.dob==='string' ? student.dob : student.dob.toISOString().split('T')[0]) : '' %>"
                               class="mahadbt-input font-medium" 
                               required>
                    </div>

                    <!-- Gender -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="users-2" class="w-3.5 h-3.5 text-orange-500"></i>
                            Gender <span class="text-red-500">*</span>
                        </label>
                        <select name="gender" class="mahadbt-input font-medium cursor-pointer" required>
                            <option value="" disabled hidden <%= !student.gender ? "selected" : "" %>>
                                Select Gender
                            </option>
                            <option value="Male" <%= student.gender === "Male" ? "selected" : "" %>>Male</option>
                            <option value="Female" <%= student.gender === "Female" ? "selected" : "" %>>Female</option>
                            <option value="Other" <%= student.gender === "Other" ? "selected" : "" %>>Other</option>
                        </select>
                    </div>

                    <!-- Blood Group -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="droplet" class="w-3.5 h-3.5 text-rose-500"></i>
                            Blood Group <span class="text-red-500">*</span>
                        </label>
                        <select name="bloodGroup" class="mahadbt-input font-medium cursor-pointer" required>
                            <option value="" disabled hidden <%= !student.bloodGroup ? "selected" : "" %>>
                                Select Blood Group
                            </option>
                            <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg => { %>
                                <option value="<%= bg %>" <%= student.bloodGroup === bg ? "selected" : "" %>><%= bg %></option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Aadhaar Number -->
                    <div class="md:col-span-2">
                        <label class="mahadbt-label">
                            <i data-lucide="fingerprint" class="w-3.5 h-3.5 text-[#d95f0b]"></i>
                            Aadhaar Card Number (12 Digits - DBT Seeded) <span class="text-red-500">*</span>
                        </label>
                        <input name="aadharNumber" 
                               maxlength="12"
                               value="<%= student.aadharNumber || '' %>"
                               placeholder="Enter 12 digit Aadhaar number"
                               class="mahadbt-input font-mono tracking-widest font-semibold text-[#0b2546]"
                               required>
                    </div>

                </div>

            </section>

            <!-- ================= 3. ACADEMIC DETAILS ================= -->
            <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm">
                
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#f47721]"></span>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            3. Academic & Enrollment Details
                        </h2>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">Session 2026-27</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    
                    <!-- Course Program -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="graduation-cap" class="w-3.5 h-3.5 text-orange-500"></i>
                            Enrolled Program / Branch <span class="text-red-500">*</span>
                        </label>
                        <select id="course" 
                                name="course" 
                                onchange="setCourseCode()"
                                class="mahadbt-input font-semibold text-[#0b2546] cursor-pointer" 
                                required>
                            <option value="" disabled hidden <%= !student.course ? "selected" : "" %>>
                                Select enrolled course
                            </option>
                            <option value="Civil Engineering" <%= student.course === "Civil Engineering" ? "selected" : "" %>>Civil Engineering</option>
                            <option value="Computer Science & Engineering" <%= student.course === "Computer Science & Engineering" ? "selected" : "" %>>Computer Science & Engineering</option>
                            <option value="Information Technology" <%= student.course === "Information Technology" ? "selected" : "" %>>Information Technology</option>
                            <option value="Electrical Engineering" <%= student.course === "Electrical Engineering" ? "selected" : "" %>>Electrical Engineering</option>
                            <option value="Mechanical Engineering" <%= student.course === "Mechanical Engineering" ? "selected" : "" %>>Mechanical Engineering</option>
                        </select>
                    </div>

                    <!-- Auto-generated Course Code Display -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="code" class="w-3.5 h-3.5 text-orange-500"></i>
                            DTE Branch Code (Auto-generated)
                        </label>
                        <input id="courseCodeDisplay" 
                               readonly
                               placeholder="Auto-generated course code"
                               class="mahadbt-input mahadbt-input-readonly font-mono font-bold text-[#d95f0b]">

                        <!-- Hidden Field holding actual courseCode value -->
                        <input type="hidden" 
                               id="courseCode" 
                               name="courseCode"
                               value="<%= student.courseCode || '' %>">
                    </div>

                    <!-- Roll Number -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="hash" class="w-3.5 h-3.5 text-orange-500"></i>
                            Class Roll Number <span class="text-red-500">*</span>
                        </label>
                        <input name="rollNumber"
                               value="<%= student.rollNumber || '' %>"
                               placeholder="e.g. 2026CS101"
                               class="mahadbt-input font-mono font-semibold text-[#0b2546]" 
                               required>
                    </div>

                    <!-- Semester -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="layers" class="w-3.5 h-3.5 text-orange-500"></i>
                            Current Academic Semester <span class="text-red-500">*</span>
                        </label>
                        <select name="semester" class="mahadbt-input font-medium cursor-pointer" required>
                            <option value="" disabled hidden <%= !student.semester ? "selected" : "" %>>
                                Select semester
                            </option>
                            <% for(let i = 1; i <= 8; i++) { %>
                                <option value="<%= i %>" <%= Number(student.semester) === i ? "selected" : "" %>>
                                    Semester <%= i %>
                                </option>
                            <% } %>
                        </select>
                    </div>

                    <!-- ABC ID -->
                    <div class="md:col-span-2">
                        <label class="mahadbt-label">
                            <i data-lucide="award" class="w-3.5 h-3.5 text-orange-500"></i>
                            Academic Bank of Credits (ABC ID / APAAR ID) <span class="text-red-500">*</span>
                        </label>
                        <input name="abcId" 
                               maxlength="12"
                               value="<%= student.abcId || '' %>"
                               placeholder="Enter 12 digit ABC ID"
                               class="mahadbt-input font-mono tracking-wider font-semibold text-[#0b2546]"
                               required>
                    </div>

                </div>

            </section>

            <!-- ================= 4. FAMILY & ADDRESS ================= -->
            <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm">
                
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#f47721]"></span>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            4. Family & Residential Address
                        </h2>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">Contact Record</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    
                    <!-- Father's Name -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="user" class="w-3.5 h-3.5 text-orange-500"></i>
                            Father's Full Name <span class="text-red-500">*</span>
                        </label>
                        <input name="fatherName"
                               value="<%= student.fatherName || '' %>"
                               placeholder="Father's full name"
                               class="mahadbt-input font-medium" 
                               required>
                    </div>

                    <!-- Mother's Name -->
                    <div>
                        <label class="mahadbt-label">
                            <i data-lucide="user" class="w-3.5 h-3.5 text-orange-500"></i>
                            Mother's Full Name <span class="text-red-500">*</span>
                        </label>
                        <input name="motherName"
                               value="<%= student.motherName || '' %>"
                               placeholder="Mother's full name"
                               class="mahadbt-input font-medium" 
                               required>
                    </div>

                    <!-- Guardian Phone -->
                    <div class="md:col-span-2">
                        <label class="mahadbt-label">
                            <i data-lucide="phone-call" class="w-3.5 h-3.5 text-rose-500"></i>
                            Emergency Guardian Contact Number <span class="text-red-500">*</span>
                        </label>
                        <input name="guardianPhone" 
                               maxlength="10"
                               value="<%= student.guardianPhone || '' %>"
                               placeholder="10 digit parent/guardian mobile number"
                               class="mahadbt-input font-mono font-medium" 
                               required>
                    </div>

                    <!-- Permanent Address -->
                    <div class="md:col-span-2">
                        <label class="mahadbt-label">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-orange-500"></i>
                            Permanent Residential Address <span class="text-red-500">*</span>
                        </label>
                        <textarea name="address" 
                                  rows="3"
                                  placeholder="House No, Flat / Apartment, Street, Landmark, Village / City, District, State, PIN Code"
                                  class="mahadbt-input resize-none leading-relaxed font-medium"
                                  required><%= student.address || "" %></textarea>
                    </div>

                </div>

            </section>

            <!-- ================= 5. SUBMIT & ACTION BUTTON ================= -->
            <div class="space-y-4">
                <button type="submit"
                        class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-[#0b2546] to-[#12396b] hover:from-[#f47721] hover:to-[#d95f0b] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 active:scale-[.99]">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    <span>Save & Update Profile Credentials</span>
                </button>

                <p class="text-center text-[11px] text-slate-400 uppercase tracking-widest font-semibold">
                    Nexus Student Information System • MahaDBT 2.0 Integrated ERP
                </p>
            </div>

        </form>

    </main>

    <!-- ================= 6. FOOTER ================= -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-4 px-4 text-center text-xs text-slate-500 no-print">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
            <span>© 2026 Avi Institute of Technology. Integrated with Maharashtra DBT Portal.</span>
            <div class="flex items-center gap-3">
                <a href="#" class="hover:text-[#f47721]">Privacy Policy</a>
                <span>•</span>
                <a href="#" class="hover:text-[#f47721]">Student Helpdesk</a>
                <span>•</span>
                <span class="text-[#f47721] font-semibold">Portal Version 2.4.0</span>
            </div>
        </div>
    </footer>

    <!-- ================= JAVASCRIPT LOGIC (EXACT LOGIC PRESERVED) ================= -->
    <script>
        // Initialize Lucide Icons
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });

        // 1. Image Preview Function (Exact logic)
        function previewImage(e) {
            const r = new FileReader();
            r.onload = () => {
                const preview = document.getElementById("profilePreview");
                if (preview) {
                    preview.src = r.result;
                }
            };
            if (e.target.files && e.target.files[0]) {
                r.readAsDataURL(e.target.files[0]);
            }
        }

        // 2. Course Code Mapping (Exact map)
        const courseMap = {
            "Civil Engineering": "0414419110",
            "Computer Science & Engineering": "0414424210",
            "Information Technology": "0414424610",
            "Electrical Engineering": "0414429310",
            "Mechanical Engineering": "0414461210"
        };

        // 3. Set Course Code Function (Exact logic)
        function setCourseCode() {
            const c = document.getElementById("course").value;
            const codeInput = document.getElementById("courseCode");
            const codeDisplay = document.getElementById("courseCodeDisplay");
            
            if (codeInput) codeInput.value = courseMap[c] || "";
            if (codeDisplay) codeDisplay.value = courseMap[c] || "";
        }

        window.onload = function() {
            setCourseCode();
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        };
    </script>
</body>
</html>