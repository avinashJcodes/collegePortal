    <!-- Script fallback loaders and basic slider control functions -->
    <script>
        // Loader Dismissal (Unchanged)
        setTimeout(() => {
            const loader = document.getElementById('loader');
            if(loader) loader.classList.add('opacity-0', 'pointer-events-none');
        }, 600);

        // Slide controller helper functions if script.js relies on global showRegister/showLogin
        function showRegister() {
            const wrapper = document.getElementById('formWrapper');
            if (wrapper) wrapper.classList.add('slide-register');
        }

        function showLogin() {
            const wrapper = document.getElementById('formWrapper');
            if (wrapper) wrapper.classList.remove('slide-register');
        }

        function togglePassword(inputId, eyeIconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(eyeIconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }
    </script>

    <!-- Custom Script linking to existing backend logic (Unchanged) -->
