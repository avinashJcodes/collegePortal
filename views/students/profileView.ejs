<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Profile & Credentials - MahaDBT 2.0 ERP</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --mahadbt-navy: #0b2546;
            --mahadbt-navy-dark: #071930;
            --mahadbt-orange: #f47721;
            --mahadbt-orange-dark: #d95f0b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .heading-font {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Subtle Government Card Grid */
        .info-field-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 0.875rem;
            padding: 1rem 1.125rem;
            transition: all 0.2s ease;
        }

        .info-field-box:hover {
            background-color: #ffffff;
            border-color: #cbd5e1;
            box-shadow: 0 2px 8px rgba(11, 37, 70, 0.04);
        }

        /* Print formatting */
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .info-field-box {
                border: 1px solid #ccc !important;
            }
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800 antialiased flex flex-col">

  

 

    <!-- ================= 3. MAIN CONTENT CONTAINER ================= -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 md:p-8 space-y-6">

        <!-- Breadcrumbs Navigation -->
        <nav class="flex items-center gap-2 text-xs text-slate-500 no-print">
            <a href="/student/dashboard" class="hover:text-[#f47721]">Home</a>
            <span>/</span>
            <span class="text-[#0b2546] font-semibold">Student Account</span>
            <span>/</span>
            <span class="text-slate-700 font-medium">My Profile</span>
        </nav>

        <!-- ================= 4. MAHADBT 2.0 PROFILE HERO CARD ================= -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 relative overflow-hidden">
            <!-- Decorative Accent Gradient -->
            <div class="absolute top-0 right-0 w-96 h-full bg-gradient-to-l from-orange-50/70 via-orange-50/20 to-transparent pointer-events-none"></div>

            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 relative z-10">
                
                <!-- Left: Avatar + Details -->
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
                    
                    <!-- Avatar with Verified Border -->
                    <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border-2 border-[#f47721] p-1 bg-white shadow-md flex-shrink-0">
                        <img src="<%= student.profileImage || 'https://ui-avatars.com/api/?background=0b2546&color=ffffff&size=200&name=' + encodeURIComponent(student.fullname) %>"
                             alt="Student Avatar"
                             class="w-full h-full object-cover rounded-xl">
                        
                        <!-- Verified Tick -->
                        <span class="absolute bottom-1 right-1 bg-emerald-500 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs shadow-sm border-2 border-white" title="Aadhaar & ERP Verified">
                            <i data-lucide="check" class="w-3.5 h-3.5"></i>
                        </span>
                    </div>

                    <!-- Name, Course, Meta Tags -->
                    <div class="space-y-2">
                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                                Verified Student
                            </span>
                            <span class="px-2.5 py-0.5 rounded-full bg-orange-50 border border-orange-200 text-[#d95f0b] text-xs font-bold">
                                MahaDBT 2.0 Enrolled
                            </span>
                        </div>

                        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0b2546] heading-font tracking-tight">
                            <%= student.fullname %>
                        </h1>

                        <p class="text-sm font-medium text-slate-600 flex items-center justify-center sm:justify-start gap-1.5">
                            <i data-lucide="graduation-cap" class="w-4 h-4 text-[#f47721]"></i>
                            <span><%= student.course || "Course Not Assigned" %></span>
                        </p>

                        <!-- Roll No & Registration Meta -->
                        <div class="pt-1 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs text-slate-500 font-medium">
                            <span class="bg-slate-100 px-3 py-1 rounded-lg border border-slate-200 text-slate-700">
                                Roll No: <strong class="text-[#0b2546] font-mono"><%= student.rollNumber || "N/A" %></strong>
                            </span>
                            <span class="bg-slate-100 px-3 py-1 rounded-lg border border-slate-200 text-slate-700">
                                Student ID: <strong class="text-[#d95f0b] font-mono"><%= student.studentId || "N/A" %></strong>
                            </span>
                        </div>
                    </div>

                </div>

                <!-- Right: Action Buttons -->
                <div class="flex flex-row sm:flex-col lg:flex-row items-center justify-center gap-3 no-print">
                    <a href="/student/profile?edit=true"
                       class="px-5 py-2.5 rounded-xl bg-[#0b2546] hover:bg-[#f47721] transition-all text-white text-xs sm:text-sm font-bold shadow-sm hover:shadow-md flex items-center gap-2 active:scale-95">
                        <i data-lucide="square-pen" class="w-4 h-4"></i>
                        <span>Edit Profile</span>
                    </a>

                    <a href="/student/logout"
                       class="px-5 py-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100 transition-all text-xs sm:text-sm font-bold flex items-center gap-2 active:scale-95">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        <span>Logout</span>
                    </a>
                </div>

            </div>
        </div>

        <!-- ================= 5. QUICK SUMMARY STATS ================= -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            
            <!-- Student ID -->
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-slate-400 mb-1.5">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Student ID / PRN</span>
                    <i data-lucide="fingerprint" class="w-4 h-4 text-orange-500"></i>
                </div>
                <h3 class="text-base sm:text-lg font-mono font-bold text-[#0b2546] truncate">
                    <%= student.studentId || "N/A" %>
                </h3>
                <span class="text-[10px] text-slate-400 mt-0.5 block">Official ERP Record</span>
            </div>

            <!-- Current Semester -->
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-slate-400 mb-1.5">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Current Term</span>
                    <i data-lucide="layers" class="w-4 h-4 text-orange-500"></i>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-[#0b2546]">
                    Semester <%= student.semester || "N/A" %>
                </h3>
                <span class="text-[10px] text-slate-400 mt-0.5 block">Academic Year 2026-27</span>
            </div>

            <!-- Course Code -->
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-slate-400 mb-1.5">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Course Code</span>
                    <i data-lucide="book-bookmark" class="w-4 h-4 text-orange-500"></i>
                </div>
                <h3 class="text-base sm:text-lg font-mono font-bold text-[#0b2546] truncate">
                    <%= student.courseCode || "N/A" %>
                </h3>
                <span class="text-[10px] text-slate-400 mt-0.5 block">Degree Curriculum</span>
            </div>

            <!-- Enrollment Status -->
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-slate-400 mb-1.5">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Status</span>
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-emerald-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Active
                </h3>
                <span class="text-[10px] text-emerald-600 font-semibold mt-0.5 block">Clear Standing</span>
            </div>

        </div>

        <!-- ================= 6. PERSONAL INFORMATION ================= -->
        <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm space-y-6">
            
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-orange-50 border border-orange-200 text-[#d95f0b] flex items-center justify-center font-bold">
                        <i data-lucide="user" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            1. Personal Information
                        </h2>
                        <p class="text-xs text-slate-500">
                            Primary identity and civil credentials of the candidate.
                        </p>
                    </div>
                </div>

                <span class="text-[11px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-md hidden sm:flex items-center gap-1">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600"></i> UIDAI Verified
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- Full Name -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Full Name</p>
                    <h3 class="text-sm sm:text-base font-bold text-[#0b2546] mt-1">
                        <%= student.fullname %>
                    </h3>
                </div>

                <!-- Email Address -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Registered Email Address</p>
                    <h3 class="text-sm sm:text-base font-semibold text-slate-800 mt-1 break-all">
                        <%= student.email %>
                    </h3>
                </div>

                <!-- Mobile Number -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Mobile Number</p>
                    <h3 class="text-sm sm:text-base font-mono font-semibold text-slate-800 mt-1">
                        <%= student.phone || "Not Available" %>
                    </h3>
                </div>

                <!-- Date of Birth -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Date of Birth</p>
                    <h3 class="text-sm sm:text-base font-semibold text-slate-800 mt-1">
                        <%= student.dob ? student.dob.toDateString() : "Not Available" %>
                    </h3>
                </div>

                <!-- Gender -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Gender</p>
                    <h3 class="text-sm sm:text-base font-semibold text-slate-800 mt-1">
                        <%= student.gender || "Not Available" %>
                    </h3>
                </div>

                <!-- Blood Group -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Blood Group</p>
                    <h3 class="text-sm sm:text-base font-bold text-rose-700 mt-1">
                        <%= student.bloodGroup || "Not Available" %>
                    </h3>
                </div>

                <!-- Aadhaar Number -->
                <div class="info-field-box md:col-span-2 bg-orange-50/40 border-orange-200/70">
                    <div class="flex items-center justify-between">
                        <p class="text-xs font-bold text-[#d95f0b] uppercase tracking-wider">Aadhaar Number (DBT Seeded)</p>
                        <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded">NPCI Linked</span>
                    </div>
                    <h3 class="text-base sm:text-lg font-mono font-bold text-[#0b2546] mt-1 tracking-wider">
                        <%= student.aadharNumber || "Not Available" %>
                    </h3>
                </div>

            </div>

        </section>

        <!-- ================= 7. ACADEMIC INFORMATION ================= -->
        <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm space-y-6">
            
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-700 flex items-center justify-center font-bold">
                        <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            2. Academic & Enrollment Details
                        </h2>
                        <p class="text-xs text-slate-500">
                            University affiliation, branch of study, and credit bank identifiers.
                        </p>
                    </div>
                </div>

                <span class="text-xs font-semibold text-slate-500 hidden sm:inline font-mono">
                    Session: 2026-27
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- Course -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Degree Program / Branch</p>
                    <h3 class="text-sm sm:text-base font-bold text-[#0b2546] mt-1">
                        <%= student.course || "Not Available" %>
                    </h3>
                </div>

                <!-- Course Code -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Branch / Course Code</p>
                    <h3 class="text-sm sm:text-base font-mono font-semibold text-slate-800 mt-1">
                        <%= student.courseCode || "Not Available" %>
                    </h3>
                </div>

                <!-- Roll Number -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Class Roll Number</p>
                    <h3 class="text-sm sm:text-base font-mono font-bold text-[#d95f0b] mt-1">
                        <%= student.rollNumber || "Not Available" %>
                    </h3>
                </div>

                <!-- Semester -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Registered Semester</p>
                    <h3 class="text-sm sm:text-base font-semibold text-slate-800 mt-1">
                        Semester <%= student.semester || "N/A" %>
                    </h3>
                </div>

                <!-- Student ID -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Permanent Registration No (PRN / ID)</p>
                    <h3 class="text-sm sm:text-base font-mono font-bold text-slate-800 mt-1">
                        <%= student.studentId || "Not Available" %>
                    </h3>
                </div>

                <!-- ABC ID -->
                <div class="info-field-box bg-slate-50 border-indigo-200/80">
                    <div class="flex items-center justify-between">
                        <p class="text-xs font-bold text-indigo-700 uppercase tracking-wider">Academic Bank of Credits (ABC ID)</p>
                        <span class="text-[9px] bg-indigo-100 text-indigo-800 font-bold px-2 py-0.5 rounded">DigiLocker</span>
                    </div>
                    <h3 class="text-sm sm:text-base font-mono font-bold text-[#0b2546] mt-1 break-all">
                        <%= student.abcId || "Not Available" %>
                    </h3>
                </div>

            </div>

        </section>

        <!-- ================= 8. EDUCATION HISTORY ================= -->
        <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm space-y-6">
            
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center font-bold">
                        <i data-lucide="book-open" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            3. Past Education History
                        </h2>
                        <p class="text-xs text-slate-500">
                            Qualifying secondary and higher secondary examination ledgers.
                        </p>
                    </div>
                </div>

                <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-md">
                    Verified Certificates
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- 10th Board -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Secondary Board (SSC / 10th)</p>
                    <h3 class="text-sm sm:text-base font-semibold text-[#0b2546] mt-1">
                        <%= student.tenthBoard || "Not Available" %>
                    </h3>
                </div>

                <!-- 10th Score -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">10th Score / Percentage</p>
                    <h3 class="text-sm sm:text-base font-bold text-emerald-700 mt-1">
                        <%= student.tenthScore || "Not Available" %>
                    </h3>
                </div>

                <!-- 12th Board -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Higher Secondary Board (HSC / 12th / Diploma)</p>
                    <h3 class="text-sm sm:text-base font-semibold text-[#0b2546] mt-1">
                        <%= student.twelfthBoard || "Not Available" %>
                    </h3>
                </div>

                <!-- 12th Score -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">12th Score / Percentage</p>
                    <h3 class="text-sm sm:text-base font-bold text-emerald-700 mt-1">
                        <%= student.twelfthScore || "Not Available" %>
                    </h3>
                </div>

            </div>

        </section>

        <!-- ================= 9. FAMILY & CONTACT ADDRESS ================= -->
        <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 shadow-sm space-y-6">
            
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 flex items-center justify-center font-bold">
                        <i data-lucide="users" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-[#0b2546] uppercase tracking-wide">
                            4. Family & Contact Information
                        </h2>
                        <p class="text-xs text-slate-500">
                            Parent, guardian contact details and permanent residential address.
                        </p>
                    </div>
                </div>

                <span class="text-[11px] font-semibold text-orange-800 bg-orange-50 border border-orange-200 px-2.5 py-1 rounded-md">
                    Emergency Contact Cell
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- Father's Name -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Father's Name</p>
                    <h3 class="text-sm sm:text-base font-semibold text-[#0b2546] mt-1">
                        <%= student.fatherName || "Not Available" %>
                    </h3>
                </div>

                <!-- Mother's Name -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Mother's Name</p>
                    <h3 class="text-sm sm:text-base font-semibold text-[#0b2546] mt-1">
                        <%= student.motherName || "Not Available" %>
                    </h3>
                </div>

                <!-- Emergency Contact -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Emergency Guardian Contact</p>
                    <h3 class="text-sm sm:text-base font-mono font-semibold text-rose-700 mt-1">
                        <%= student.guardianPhone || "Not Available" %>
                    </h3>
                </div>

                <!-- Phone -->
                <div class="info-field-box">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Student Contact Number</p>
                    <h3 class="text-sm sm:text-base font-mono font-semibold text-slate-800 mt-1">
                        <%= student.phone || "Not Available" %>
                    </h3>
                </div>

                <!-- Residential Address -->
                <div class="info-field-box md:col-span-2">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Permanent Residential Address</p>
                    <p class="text-sm sm:text-base text-slate-700 leading-relaxed mt-1 font-medium">
                        <%= student.address || "Address not available" %>
                    </p>
                </div>

            </div>

        </section>

        <!-- Official Security & Verification Notice -->
        <div class="p-4 bg-slate-100 border border-slate-200 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-emerald-600 text-sm"></i>
                <span>Data certified under Maharashtra Higher Education Digital ERP Regulations.</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-slate-400">
                NEXUS STUDENT INFORMATION SYSTEM • SECURE DATABASE
            </span>
        </div>

    </main>

    <!-- ================= 10. FOOTER ================= -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-4 px-4 text-center text-xs text-slate-500 no-print">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
            <span>© 2026 Avi Institute of Technology. Integrated with Maharashtra DBT & University Portal.</span>
            <div class="flex items-center gap-3">
                <a href="#" class="hover:text-[#f47721]">Privacy Policy</a>
                <span>•</span>
                <a href="#" class="hover:text-[#f47721]">Student Helpdesk</a>
                <span>•</span>
                <span class="text-[#f47721] font-semibold">Portal Version 2.4.0</span>
            </div>
        </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
</body>
</html>