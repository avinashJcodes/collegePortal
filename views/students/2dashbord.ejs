    <script>
        // Accessibility: Font Size Adjustment Functionality
        let currentScale = 100;
        function adjustFontSize(direction) {
            currentScale += direction * 7;
            if (currentScale < 86) currentScale = 86;
            if (currentScale > 120) currentScale = 120;
            document.body.style.fontSize = (currentScale / 100) + 'rem';
        }

        function resetFontSize() {
            currentScale = 100;
            document.body.style.fontSize = '1rem';
        }

        // Accessibility: High Contrast Mode Toggle
        function toggleContrastMode() {
            document.body.classList.toggle('high-contrast-mode');
        }
    </script>
