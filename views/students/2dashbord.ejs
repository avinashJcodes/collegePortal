<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Avi Institute of Technology - College Portal Header</title>
    
    <!-- Google Fonts: Inter, Poppins & Noto Sans Devanagari (Marathi) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --portal-navy: #082444;
            --portal-navy-dark: #05182e;
            --portal-blue-mid: #0d386d;
            --portal-saffron: #f47721;
            --portal-saffron-hover: #d86211;
            --portal-gold: #ffc107;
            --portal-light-bg: #f8fafc;
            --portal-border: #e2e8f0;
            --portal-text-dark: #1e293b;
            --portal-text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--portal-text-dark);
            background-color: #f1f5f9;
            line-height: 1.5;
        }

        /* Accessibility: High Contrast Mode */
        body.high-contrast-mode {
            background-color: #000 !important;
            color: #ffff00 !important;
        }
        body.high-contrast-mode .top-utility-bar,
        body.high-contrast-mode .main-branding-bar,
        body.high-contrast-mode .college-navbar,
        body.high-contrast-mode .notification-ticker-bar {
            background-color: #121212 !important;
            color: #ffff00 !important;
            border-color: #ffff00 !important;
        }
        body.high-contrast-mode a,
        body.high-contrast-mode .nav-link,
        body.high-contrast-mode .dropdown-item {
            color: #ffff00 !important;
        }

        /* ========================================================
           1. TOP UTILITY & ACCESSIBILITY BAR (MahaDBT Standard)
        ======================================================== */
        .top-utility-bar {
            background-color: var(--portal-navy-dark);
            color: #cbd5e1;
            font-size: 0.78rem;
            padding: 5px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .top-utility-bar a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .top-utility-bar a:hover {
            color: #ffffff;
        }

        .util-badge {
            background: rgba(244, 119, 33, 0.2);
            color: #ffb17a;
            border: 1px solid rgba(244, 119, 33, 0.35);
            font-size: 0.72rem;
            padding: 1px 7px;
            border-radius: 3px;
            font-weight: 600;
        }

        .access-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            font-size: 0.72rem;
            padding: 2px 7px;
            border-radius: 3px;
            cursor: pointer;
            line-height: 1.2;
            transition: all 0.2s;
        }

        .access-btn:hover {
            background: var(--portal-saffron);
            border-color: var(--portal-saffron);
            color: #fff;
        }

        /* ========================================================
           2. MAIN BRANDING BAR (College Identity & Badges)
        ======================================================== */
        .main-branding-bar {
            background-color: #ffffff;
            padding: 14px 0;
            border-bottom: 1px solid var(--portal-border);
        }

        .college-crest-box {
            width: 76px;
            height: 76px;
            min-width: 76px;
            background: linear-gradient(135deg, var(--portal-blue-mid) 0%, var(--portal-navy-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 2.2rem;
            box-shadow: 0 4px 12px rgba(8, 36, 68, 0.2);
            border: 3px solid #ffffff;
            outline: 2px solid var(--portal-saffron);
        }

        .inst-name-regional {
            font-family: 'Noto Sans Devanagari', sans-serif;
            font-size: 0.95rem;
            color: var(--portal-saffron);
            font-weight: 700;
            margin-bottom: -2px;
            letter-spacing: 0.2px;
        }

        .inst-name-main {
            font-family: 'Poppins', sans-serif;
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--portal-navy);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin: 0;
            line-height: 1.2;
        }

        .inst-accreditation-sub {
            font-size: 0.77rem;
            color: var(--portal-text-muted);
            font-weight: 500;
            margin-top: 2px;
        }

        .accreditation-pill {
            background-color: #f8fafc;
            border: 1px solid var(--portal-border);
            padding: 6px 12px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .naac-seal {
            background: linear-gradient(135deg, #16a34a, #15803d);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 4px;
            letter-spacing: 0.5px;
        }

        /* ========================================================
           3. PRIMARY NAVIGATION BAR (MahaDBT 2.0 Style)
        ======================================================== */
        .college-navbar {
            background-color: var(--portal-navy);
            padding: 0;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
            border-top: 3px solid var(--portal-saffron);
        }

        .college-navbar .nav-link {
            color: #f8fafc !important;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 15px 13px !important;
            transition: all 0.2s ease;
            position: relative;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .college-navbar .nav-link:hover,
        .college-navbar .nav-item.active .nav-link {
            background-color: rgba(255, 255, 255, 0.08);
            color: var(--portal-gold) !important;
        }

        .college-navbar .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 3px;
            background-color: var(--portal-saffron);
            transition: width 0.25s ease;
        }

        .college-navbar .nav-link:hover::after,
        .college-navbar .nav-item.active .nav-link::after {
            width: 75%;
        }

        /* Dropdown Menus */
        .college-navbar .dropdown-menu {
            border: none;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
            padding: 8px 0;
            margin-top: 1px;
            border-top: 3px solid var(--portal-saffron);
            background-color: #ffffff;
            animation: navFadeIn 0.2s ease-in-out;
        }

        .college-navbar .dropdown-item {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--portal-text-dark);
            padding: 8px 18px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .college-navbar .dropdown-item:hover {
            background-color: #fff4eb;
            color: var(--portal-saffron);
            padding-left: 22px;
        }

        .college-navbar .dropdown-item i {
            font-size: 0.85rem;
            width: 16px;
            text-align: center;
        }

        /* MahaDBT Saffron Action Login Button */
        .btn-portal-action {
            background: linear-gradient(135deg, var(--portal-saffron) 0%, #e05e07 100%);
            color: #ffffff !important;
            font-weight: 700;
            font-size: 0.88rem;
            padding: 8px 18px;
            border-radius: 5px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 3px 10px rgba(244, 119, 33, 0.35);
            transition: all 0.25s ease;
        }

        .btn-portal-action:hover {
            background: linear-gradient(135deg, #e05e07 0%, #c44f02 100%);
            box-shadow: 0 4px 14px rgba(244, 119, 33, 0.5);
            transform: translateY(-1px);
        }

        /* ========================================================
           4. NOTIFICATION / CIRCULAR TICKER BAR
        ======================================================== */
        .notification-ticker-bar {
            background: #ffffff;
            border-bottom: 1px solid var(--portal-border);
            padding: 6px 0;
            font-size: 0.84rem;
            display: flex;
            align-items: center;
        }

        .ticker-tag {
            background: #dc2626;
            color: #ffffff;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .ticker-marquee a {
            color: var(--portal-navy);
            text-decoration: none;
            font-weight: 600;
            margin-right: 40px;
            transition: color 0.15s ease;
        }

        .ticker-marquee a:hover {
            color: var(--portal-saffron);
            text-decoration: underline;
        }

        @keyframes navFadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive Fixes */
        @media (max-width: 991.98px) {
            .college-navbar .nav-link {
                padding: 10px 14px !important;
            }
            .inst-name-main {
                font-size: 1.15rem;
            }
        }
    </style>
</head>
