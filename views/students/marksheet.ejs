<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic Results & Marksheet - MahaDBT 2.0 Student ERP</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --mahadbt-navy: #0b2546;
            --mahadbt-orange: #f47721;
            --mahadbt-orange-dark: #d95f0b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .heading-font {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Print formatting */
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
            }
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800 antialiased flex flex-col">



    <!-- ================= 3. MAIN CONTAINER ================= -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 md:p-8 space-y-6">

        <!-- Page Title & Verification Banner -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 right-0 w-80 h-full bg-gradient-to-l from-orange-50 via-orange-50/40 to-transparent pointer-events-none"></div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 relative z-10">
                <div>
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-2 no-print">
                        <a href="/student/dashboard" class="hover:text-[#f47721]">Home</a>
                        <span>/</span>
                        <span class="text-[#0b2546] font-semibold">Examinations</span>
                        <span>/</span>
                        <span class="text-slate-700 font-medium">Academic Results</span>
                    </nav>

                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-xl bg-[#0b2546] text-[#f47721] flex items-center justify-center font-bold flex-shrink-0 shadow-sm">
                            <i data-lucide="award" class="w-6 h-6 text-[#f47721]"></i>
                        </div>
                        <div>
                            <h2 class="text-xl sm:text-2xl font-bold text-[#0b2546] heading-font">
                                Student Academic Scorecard & Marksheets
                            </h2>
                            <p class="text-xs sm:text-sm text-slate-500">
                                Official semester examination statements, ledger grades, and downloadable transcripts.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Verified Badge -->
                <div class="flex items-center gap-2 self-start md:self-auto">
                    <div class="bg-emerald-50 border border-emerald-200/80 px-3.5 py-2 rounded-xl flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/15 text-emerald-700 flex items-center justify-center font-bold">
                            <i data-lucide="shield-check" class="w-4 h-4"></i>
                        </div>
                        <div class="text-left">
                            <span class="text-[10px] uppercase font-extrabold text-emerald-800 tracking-wider block">Controller of Exams</span>
                            <span class="text-xs font-bold text-emerald-900">Digitally Authenticated</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= 4. 👤 STUDENT INFO ROW (MAHADBT 2.0 WHITE UI) ================= -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 sm:gap-4">
            
            <!-- Student Name -->
            <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs relative overflow-hidden group hover:border-[#f47721]/50 transition duration-200">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                        Student Name
                    </span>
                    <i data-lucide="user" class="w-4 h-4 text-orange-500/70"></i>
                </div>
                <p class="text-[#0b2546] text-sm sm:text-base font-bold truncate" title="<%= student.fullname %>">
                    <%= student.fullname %>
                </p>
                <span class="text-[10px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Verified Profile
                </span>
            </div>

            <!-- Admission No -->
            <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs relative overflow-hidden group hover:border-[#f47721]/50 transition duration-200">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                        Admission / PRN No
                    </span>
                    <i data-lucide="fingerprint" class="w-4 h-4 text-orange-500/70"></i>
                </div>
                <p class="text-[#d95f0b] text-sm sm:text-base font-mono font-bold tracking-tight">
                    <%= student.admissionNumber %>
                </p>
                <span class="text-[10px] text-slate-400 block mt-1">
                    Enrollment ID
                </span>
            </div>

            <!-- Semester -->
            <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs relative overflow-hidden group hover:border-[#f47721]/50 transition duration-200">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                        Current Semester
                    </span>
                    <i data-lucide="layers" class="w-4 h-4 text-orange-500/70"></i>
                </div>
                <p class="text-[#0b2546] text-sm sm:text-base font-bold">
                    <%= student.semester || 'N/A' %>
                </p>
                <span class="text-[10px] text-slate-400 block mt-1">
                    Academic Term
                </span>
            </div>

            <!-- Course -->
            <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs relative overflow-hidden group hover:border-[#f47721]/50 transition duration-200">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                        Program / Course
                    </span>
                    <i data-lucide="graduation-cap" class="w-4 h-4 text-orange-500/70"></i>
                </div>
                <p class="text-[#0b2546] text-sm sm:text-base font-bold truncate" title="<%= student.course || 'N/A' %>">
                    <%= student.course || 'N/A' %>
                </p>
                <span class="text-[10px] text-slate-400 block mt-1">
                    Degree Track
                </span>
            </div>

        </div>

        <!-- ================= 5. MAIN RESULTS SECTION ================= -->
        <% if (typeof results !== "undefined" && results.length > 0) { %>

            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                
                <!-- Table Header Bar -->
                <div class="bg-slate-50/80 px-6 py-4 border-b border-slate-200 flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-[#f47721]"></span>
                        <h3 class="text-xs sm:text-sm font-bold text-[#0b2546] uppercase tracking-wider">
                            Examination Statements Ledger
                        </h3>
                    </div>
                    <span class="text-xs text-slate-500">
                        Total Records: <strong class="text-slate-800"><%= results.length %></strong>
                    </span>
                </div>

                <!-- Desktop Table View -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-100/50 text-[11px] font-bold uppercase tracking-wider text-slate-600">
                                <th class="py-3.5 px-6">Examination & Session</th>
                                <th class="py-3.5 px-6">Candidate Details</th>
                                <th class="py-3.5 px-6 text-center">Result Status</th>
                                <th class="py-3.5 px-6 text-right">Official Marksheet</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-100 text-sm">
                            <% results.forEach(result => { %>
                                <tr class="hover:bg-orange-50/30 transition-colors">
                                    
                                    <!-- Exam -->
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-lg bg-orange-100/80 text-[#d95f0b] flex items-center justify-center font-bold flex-shrink-0">
                                                <i data-lucide="file-check-2" class="w-4 h-4"></i>
                                            </div>
                                            <div>
                                                <p class="text-[#0b2546] font-bold text-sm">
                                                    <%= result.examType %>
                                                </p>
                                                <p class="text-xs text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                                    <i class="fa-regular fa-calendar text-[10px] text-orange-500"></i>
                                                    <%= result.session || 'Session 2026-27' %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Student -->
                                    <td class="py-4 px-6">
                                        <div>
                                            <p class="text-slate-800 font-semibold text-sm">
                                                <%= student.fullname %>
                                            </p>
                                            <p class="text-xs text-[#d95f0b] font-mono mt-0.5">
                                                PRN: <%= student.admissionNumber %>
                                            </p>
                                        </div>
                                    </td>

                                    <!-- Result -->
                                    <td class="py-4 px-6 text-center">
                                        <% const isPass = (result.finalResult && result.finalResult.toUpperCase() === 'PASS'); %>
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wide border
                                            <%= isPass 
                                                ? 'bg-emerald-50 text-emerald-800 border-emerald-300/80' 
                                                : 'bg-rose-50 text-rose-800 border-rose-300/80' %>">
                                            
                                            <span class="w-2 h-2 rounded-full <%= isPass ? 'bg-emerald-600 animate-pulse' : 'bg-rose-600' %>"></span>
                                            <%= result.finalResult %>
                                        </span>
                                    </td>

                                    <!-- Action -->
                                    <td class="py-4 px-6 text-right">
                                        <a href="<%= result.downloadUrl || '/marks/marksheet/download' %>"
                                           target="_blank"
                                           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#0b2546] hover:bg-[#f47721] text-white text-xs font-semibold transition-all shadow-xs hover:shadow-md">
                                            <i data-lucide="download" class="w-3.5 h-3.5"></i>
                                            <span>Download Marksheet</span>
                                        </a>
                                    </td>

                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Notice inside Results -->
                <div class="px-6 py-3 bg-slate-50 border-t border-slate-200 text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-info text-[#f47721] text-[11px]"></i>
                        <span>In case of any discrepancies in marks, contact the College Exam Cell within 7 days.</span>
                    </div>
                    <span class="text-slate-400 font-mono text-[11px]">SPPU Examination Ledger 2.0</span>
                </div>

            </div>

        <% } else { %>

            <!-- ================= EMPTY STATE ================= -->
            <div class="bg-white border border-slate-200 rounded-2xl p-12 sm:p-16 text-center shadow-sm">
                
                <div class="w-20 h-20 mx-auto rounded-2xl bg-orange-50 border border-orange-200 text-[#f47721] flex items-center justify-center mb-5 shadow-inner">
                    <i data-lucide="hourglass" class="w-10 h-10 animate-pulse"></i>
                </div>

                <h3 class="text-2xl font-bold text-[#0b2546] heading-font mb-2">
                    Results <span class="text-[#d95f0b]">Awaited</span>
                </h3>

                <p class="text-slate-500 text-sm max-w-md mx-auto leading-relaxed">
                    Your semester marks statement and examination ledgers will be displayed here once officially published by the university evaluation board.
                </p>

                <div class="mt-6 flex items-center justify-center gap-3">
                    <button onclick="window.location.reload()"
                            type="button"
                            class="px-6 py-2.5 rounded-xl bg-[#0b2546] hover:bg-[#f47721] text-white text-xs font-bold shadow-sm transition flex items-center gap-2">
                        <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
                        <span>Refresh Results</span>
                    </button>
                    <a href="/student/dashboard" 
                       class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition">
                        Back to Home
                    </a>
                </div>

            </div>

        <% } %>

    </main>

    <!-- ================= 6. FOOTER ================= -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-4 px-4 text-center text-xs text-slate-500 no-print">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
            <span>© 2026 Avi Institute of Technology. Integrated with Maharashtra DBT & University Exam Portal.</span>
            <div class="flex items-center gap-3">
                <a href="#" class="hover:text-[#f47721]">Exam Rules</a>
                <span>•</span>
                <a href="#" class="hover:text-[#f47721]">Revaluation Cell</a>
                <span>•</span>
                <span class="text-[#f47721] font-semibold">Portal Version 2.4.0</span>
            </div>
        </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
</body>
</html>